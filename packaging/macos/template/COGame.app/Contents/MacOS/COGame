#!/bin/bash
set -u

DIR="$(cd "$(dirname "$0")"/.. && pwd)"
RESOURCES="$DIR/Resources"
JAR="$RESOURCES/COGame-Client.jar"
LOG_FILE="/tmp/cogame-macos.log"

exec > "$LOG_FILE" 2>&1
echo "=== COGame macOS 启动诊断日志 $(date) ==="
echo "App 目录: $DIR"
echo "JAR 路径: $JAR"

check_java_version() {
    local j_bin="$1"
    if [ ! -x "$j_bin" ]; then
        return 1
    fi
    local ver_str
    ver_str=$("$j_bin" -version 2>&1 | awk -F '"' '/version/ {print $2}')
    if [ -z "$ver_str" ]; then
        return 1
    fi
    local major
    major=$(echo "$ver_str" | awk -F '.' '{print ($1 == 1 ? $2 : $1)}')
    if [ -n "$major" ] && [ "$major" -ge 17 ] 2>/dev/null; then
        echo "✅ 发现合格 Java 版本 ($ver_str, 主版本 $major): $j_bin"
        return 0
    fi
    echo "⚠️ 候选 Java 版本不满足要求 ($ver_str, 需要 >= 17): $j_bin"
    return 1
}

JAVA_CMD=""

# 1. 优先使用环境变量中的 JAVA_HOME
if [ -n "${JAVA_HOME:-}" ] && check_java_version "$JAVA_HOME/bin/java"; then
    JAVA_CMD="$JAVA_HOME/bin/java"
fi

# 2. 检查 /usr/libexec/java_home
if [ -z "$JAVA_CMD" ] && [ -x "/usr/libexec/java_home" ]; then
    JH=$(/usr/libexec/java_home -v 17+ 2>/dev/null || true)
    if [ -n "$JH" ] && check_java_version "$JH/bin/java"; then
        JAVA_CMD="$JH/bin/java"
    fi
fi

# 3. 检查 macOS 常见 JDK 安装路径（Homebrew M1/Intel、系统 JVM、SDKMAN、ASDF）
if [ -z "$JAVA_CMD" ]; then
    CANDIDATES=(
        "/opt/homebrew/opt/openjdk@17/bin/java"
        "/opt/homebrew/opt/openjdk@21/bin/java"
        "/opt/homebrew/opt/openjdk/bin/java"
        "/usr/local/opt/openjdk@17/bin/java"
        "/usr/local/opt/openjdk@21/bin/java"
        "/usr/local/opt/openjdk/bin/java"
        "$HOME/.sdkman/candidates/java/current/bin/java"
        "$HOME/.asdf/shims/java"
    )
    for p in "${CANDIDATES[@]}"; do
        if check_java_version "$p"; then
            JAVA_CMD="$p"
            break
        fi
    done
fi

# 4. 遍历 /Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java
if [ -z "$JAVA_CMD" ]; then
    for p in /Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java; do
        if check_java_version "$p"; then
            JAVA_CMD="$p"
            break
        fi
    done
fi

# 5. 最后检查 PATH 中的 java
if [ -z "$JAVA_CMD" ]; then
    SYS_JAVA=$(command -v java 2>/dev/null || true)
    if [ -n "$SYS_JAVA" ] && check_java_version "$SYS_JAVA"; then
        JAVA_CMD="$SYS_JAVA"
    fi
fi

if [ -z "$JAVA_CMD" ]; then
    echo "❌ 未检测到可用的 Java 17+ 运行环境"
    osascript -e 'display dialog "运行 COGame 需要 Java 17 或更高版本。\n\n未检测到已安装的 Java 17+。\n请前往官网安装，或在终端执行：\nbrew install openjdk@17" with title "COGame - 环境提示" buttons {"前往下载 Adoptium", "取消"} default button 1 with icon stop' 2>/dev/null || true
    open "https://adoptium.net/temurin/releases/?version=17" 2>/dev/null || true
    exit 1
fi

echo "🚀 使用 Java 启动游戏: $JAVA_CMD"
exec "$JAVA_CMD" \
    -Xdock:name="COGame" \
    -Dapple.awt.application.name="COGame" \
    -Dapple.laf.useScreenMenuBar=true \
    -Dfile.encoding=UTF-8 \
    -jar "$JAR" "$@"
